-- Combat: encoded must be declared OUTSIDE of a conditional, otherwise it is nil on FireServer.
local HitRemote, Seed, LastAttackTime, LastCombatWarning = nil, nil, 0, 0
local v106 = tostring(LocalPlayer.UserId):sub(2,4) .. tostring(coroutine.running()):sub(11,15)
task.spawn(function()
    while ScreenGui.Parent do
        if not Seed then
            local ok, value = pcall(function() return Net.seed:InvokeServer() * 2 end)
            if ok then Seed = value end
        end
        if not HitRemote then
            for _, path in ipairs({"Util","Remotes","Assets","Common","FX"}) do
                local folder = ReplicatedStorage:FindFirstChild(path)
                if folder then
                    for _, remote in ipairs(folder:GetChildren()) do
                        if remote:IsA("RemoteEvent") and remote:GetAttribute("Id") then
                            HitRemote = remote
                            break
                        end
                    end
                end
                if HitRemote then break end
            end
        end
        task.wait(2)
    end
end)
local function IsAlive(mob)
    return mob and mob.Parent and mob:FindFirstChild("Humanoid") and
        mob:FindFirstChild("HumanoidRootPart") and mob.Humanoid.Health > 0
end
local function Attack(mobs)
    if os.clock() - LastAttackTime < 0.2 then return end
    local list = typeof(mobs) == "table" and mobs or {mobs}
    local first = list[1]
    if not IsAlive(first) then return end
    if not Seed or not HitRemote or not HitRemote.Parent or not HitRemote:GetAttribute("Id") then
        if os.clock() - LastCombatWarning > 5 then
            LastCombatWarning = os.clock()
            warn("[AUTO FARM][ATTACK] Seed or hit remote is not ready; check game version/executor")
        end
        return
    end
    LastAttackTime = os.clock()
    if not GetCharacter():FindFirstChild("HasBuso") then SafeInvoke("Buso") end
    local encoded = ""
    local key = math.floor(workspace:GetServerTimeNow() / 10 % 10)
    for i = 1, #"RE/RegisterHit" do
        encoded = encoded .. string.char(bit32.bxor(string.byte("RE/RegisterHit", i), key + 1))
    end
    local hits = {}
    for _, mob in ipairs(list) do
        if IsAlive(mob) then
            local head = mob:FindFirstChild("Head")
            if head then
                table.insert(hits, {mob, head})
                table.insert(hits, mob)
            end
        end
    end
    if #hits == 0 then return end
    local head = first:FindFirstChild("Head")
    local ok, err = pcall(function()
        Net["RE/RegisterAttack"]:FireServer(0)
        local id = bit32.bxor(HitRemote:GetAttribute("Id") + 909090, Seed)
        if #hits == 2 then
            -- Original single-mob protocol uses a flat {mob, head} target list
            -- and no extra nil argument before v106.
            local target = {first, head}
            HitRemote:FireServer(encoded, id, head, target, v106)
            Net["RE/RegisterHit"]:FireServer(head, target, v106)
        else
            -- Multi-mob protocol uses paired {mob, head}, mob entries.
            HitRemote:FireServer(encoded, id, head, hits, nil, v106)
            Net["RE/RegisterHit"]:FireServer(head, hits, nil, v106)
        end
    end)
    if not ok and os.clock() - LastCombatWarning > 5 then
        LastCombatWarning = os.clock()
        warn("[AUTO FARM][ATTACK] " .. tostring(err))
    end
    local skills = LocalPlayer.PlayerGui:FindFirstChild("Main")
    skills = skills and skills:FindFirstChild("Skills")
    if skills then
        local style = skills:FindFirstChild("Black Leg") or skills:FindFirstChild("Death Step")
        local tool = style and IsOwn(style.Name)
        local v = style and style:FindFirstChild("V")
        local required = style and (style.Name == "Black Leg" and 150 or 400)
        if v and tool and tool:FindFirstChild("Level") and tool.Level.Value >= required then
            local cooldown = v:FindFirstChild("Cooldown")
            if cooldown and cooldown.AbsoluteSize.X <= 0.1 then
                pcall(function()
                    local input = game:GetService("VirtualInputManager")
                    input:SendKeyEvent(true, Enum.KeyCode.V, false, game)
                    input:SendKeyEvent(false, Enum.KeyCode.V, false, game)
                end)
            end
        end
    end
end
local function GetNearestMob(origin, maxDistance)
    if not IsAlive(origin) then return nil end
    local best, bestDistance = nil, math.huge
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    for _, mob in ipairs(enemies:GetChildren()) do
        if mob ~= origin and mob.Name == origin.Name and IsAlive(mob) then
            local dist = (mob.HumanoidRootPart.Position - origin.HumanoidRootPart.Position).Magnitude
            if dist < bestDistance and dist <= (maxDistance or 350) then
                best, bestDistance = mob, dist
            end
        end
    end
    return best
end
local function HoldMob(mob, cf)
    if not IsAlive(mob) then return end
    local root = mob.HumanoidRootPart
    mob.Humanoid.JumpPower = 0
    mob.Humanoid.WalkSpeed = 0
    root.CanCollide = false
    local bv = root:FindFirstChild("BringVelocity")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "BringVelocity"
        bv.MaxForce = Vector3.new(100000,100000,100000)
        bv.Parent = root
    end
    bv.Velocity = Vector3.zero
    if cf then root.CFrame = cf end
end
local AttackRotation, LastRotate = 0, 0
local function SmartMoveAndAttack(mainMob, QuestTitle, Quest, IsCheckQuest, CustomName)
    if IsCheckQuest == nil then IsCheckQuest = true end
    if not IsAlive(mainMob) or FruitBusy then return false end
    pcall(function() sethiddenproperty(LocalPlayer,"SimulationRadius",math.huge) end)
    local secondMob
    repeat
        if not IsAlive(mainMob) or FruitBusy then break end
        if IsCheckQuest and Quest and not Quest.Visible then break end
        if IsCheckQuest and QuestTitle and not string.find(QuestTitle.Text, CustomName or mainMob.Name, 1, true) then break end
        local hrp = GetHRP()
        if not hrp then break end
        local targetRoot = mainMob.HumanoidRootPart
        HoldMob(mainMob)
        if not IsAlive(secondMob) then secondMob = GetNearestMob(mainMob, 350) end
        if IsAlive(secondMob) then HoldMob(secondMob, targetRoot.CFrame) else secondMob = nil end
        title.Text = "Auto Farming | Kill " .. mainMob.Name
        if (hrp.Position - targetRoot.Position).Magnitude > 150 then
            Tween(targetRoot.CFrame * CFrame.new(0, 8, 0), 325)
        else
            CancelMove()
            EquipWeapon("Melee")
            if os.clock() - LastRotate >= 0.25 then
                AttackRotation = (AttackRotation + 180) % 360
                LastRotate = os.clock()
            end
            hrp.CFrame = targetRoot.CFrame * CFrame.new(0, 8, 0) * CFrame.Angles(0, math.rad(AttackRotation), 0)
            Attack(secondMob and {mainMob,secondMob} or mainMob)
        end
        task.wait(0.08)
    until false
    return not IsAlive(mainMob)
end
local function FindEnemy(name)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == name and IsAlive(mob) then return mob end
    end
    return nil
end
local function FarmBoss(name, position, quest, questTitle)
    local mob = FindEnemy(name)
    if mob then
        return SmartMoveAndAttack(mob, questTitle, quest, false)
    end
    title.Text = "Waiting for " .. name
    MoveTo(position)
    return false
end

