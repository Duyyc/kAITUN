 local btn=button(page,name..': '..tostring(S[key]),function() end)
 btn.MouseButton1Click:Connect(function()
  index=index%#items+1;S[key]=items[index];btn.Text=name..': '..tostring(S[key]);stopMotion()
 end)
 return btn
end
