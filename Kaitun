local function findFruit()
 local best,dist=nil,math.huge
 local root=hrp()
 if not root then return nil end
 -- Blox Fruits dropped fruits are usually Models with Handle; never pick inventory Tools of other players.
 for _,obj in ipairs(workspace:GetChildren()) do
  local h=obj:FindFirstChild('Handle')
  if obj:IsA('Model') and h and h:IsA('BasePart') and obj.Name:lower():find('fruit',1,true) then
   local d=(h.Position-root.Position).Magnitude
   if d<dist then best,dist=obj,d end
  end
 end
 return best
end
