local function KaitunWorld1(Quest, QuestTitle, level, info)
    if level >= 700 then
        title.Text = "Doing Second Sea Puzzle"
        local progress = SafeInvoke("DressrosaQuestProgress")
        if SafeInvoke("DressrosaQuestProgress", "Dressrosa") then
            title.Text = "Travel To Second Sea"
            SafeInvoke("TravelDressrosa")
        elseif type(progress) == "table" and progress.TalkedDetective and progress.UsedKey then
            if FindEnemy("Ice Admiral") then
                FarmBoss("Ice Admiral", CFrame.new(1382,27,-1459), Quest, QuestTitle)
            else
                MoveTo(CFrame.new(1382.562,27,-1458.777))
            end
            SafeInvoke("TravelDressrosa")
        elseif IsOwn("Key") then
            SafeInvoke("DressrosaQuestProgress","UseKey")
        else
            SafeInvoke("DressrosaQuestProgress","Detective")
        end
        return
    end
    local jungle = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Jungle")
    local final = jungle and jungle:FindFirstChild("Final")
    local finalPart = final and final:FindFirstChild("Part")
    if level >= 200 and getgenv().Configs.Saber and not IsSaber and finalPart and finalPart.CanCollide then
        title.Text = "Saber Quest | Solve Puzzle"
        local plates = jungle:FindFirstChild("QuestPlates")
        local door = plates and plates:FindFirstChild("Door")
        if door and door.CanCollide then
            for _, plate in ipairs(plates:GetChildren()) do
                if plate:IsA("Model") and plate:FindFirstChild("Button") and plate.Button.BrickColor ~= BrickColor.new("Camo") then
                    title.Text = "Saber Quest | Touch Plate"
                    MoveAndWait(plate.Button.CFrame, 35)
                    break
