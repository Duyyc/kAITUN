local function makeBV(root)
 if flightBV and flightBV.Parent==root then return end
 if flightBV then flightBV:Destroy() end
 flightBV=Instance.new('BodyVelocity')
 flightBV.Name='NebulaFlight';flightBV.MaxForce=Vector3.new(0,1e7,0)
 flightBV.Velocity=Vector3.zero;flightBV.Parent=root
end
-- Only one active movement tween. Arrival is within 5 studs; never teleport
-- 150 studs, and never drop to ground during combat.
local function go(dest,limit)
 local root=hrp();local h=hum()
 if not root or not h or h.Health<=0 or not dest then stopMotion();return false end
 local reach=limit or 5
 local d=(root.Position-dest.Position).Magnitude
 if d<=reach then cleanupMove();return true end
 if flight and flight.PlaybackState==Enum.PlaybackState.Playing and flightDest
   and (flightDest.Position-dest.Position).Magnitude<7 and flightRoot==root then return false end
 cleanupMove()
 local rise=math.max(root.Position.Y,dest.Position.Y)+35
 local destPos=dest.Position
 local wp
 if d>75 and root.Position.Y<rise-10 then
   wp=CFrame.new(root.Position.X,rise,root.Position.Z)
 elseif d>75 and (Vector3.new(root.Position.X,0,root.Position.Z)-Vector3.new(destPos.X,0,destPos.Z)).Magnitude>35 then
   wp=CFrame.new(destPos.X,rise,destPos.Z)
 else wp=dest end
 makeBV(root)
 flightDest=dest;flightRoot=root
 local dist=(root.Position-wp.Position).Magnitude
 flight=TweenService:Create(root,TweenInfo.new(math.max(0.06,dist/math.max(90,S.speed)),Enum.EasingStyle.Linear),{CFrame=wp})
 flight:Play()
 return false
end
local function equipped(kind)
 local c=char();if not c then return nil end
 for _,holder in ipairs({c,LP:FindFirstChildOfClass('Backpack')}) do
  if holder then for _,tool in ipairs(holder:GetChildren()) do
   if tool:IsA('Tool') and ((kind=='Any' and tool.ToolTip~='Blox Fruit') or tool.Name==kind or tool.ToolTip==kind) then
    if tool.Parent~=c and hum() then pcall(function() hum():EquipTool(tool) end) end
    return tool
   end
  end end
 end
 return nil
end
local function own(name)
 local c=char();return (c and c:FindFirstChild(name)) or (LP:FindFirstChild('Backpack') and LP.Backpack:FindFirstChild(name))
end
local function alive(m)
 return m and m.Parent and m:FindFirstChild('HumanoidRootPart') and m:FindFirstChild('Humanoid') and m.Humanoid.Health>0
end
local function nearestMob(name,around,maxDist)
 local enemies=workspace:FindFirstChild('Enemies'); if not enemies then return nil end
 local best,dist=nil,maxDist or math.huge
 for _,v in ipairs(enemies:GetChildren()) do
  if alive(v) and (not name or v.Name==name or v.Name:match('^'..name..' %[Lv%.')) then
   local d=(v.HumanoidRootPart.Position-around).Magnitude
   if d<dist then best,dist=v,d end
  end
 end
 return best
end
local function fight(m)
 if not alive(m) then S.target=nil;return false end
 local root=hrp();local h=hum()
 if not root or not h then return false end
 if S.safe and h.Health/h.MaxHealth<0.48 then
  S.target=nil;status('Máu thấp: đang rút lui')
  return go(CFrame.new(root.Position+Vector3.new(0,55,0)),4)
 end
 equipped(S.weapon)
 S.target=m
 local pos=m.HumanoidRootPart.Position+Vector3.new(0,S.height,0)
 local cf=CFrame.new(pos,m.HumanoidRootPart.Position)
 if (root.Position-pos).Magnitude>7 then go(cf,6) else
   if flight then cleanupMove() end
   makeBV(root)
 end
 status('Đánh: '..m.Name)
 return true
end
