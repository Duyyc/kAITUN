local function getQuest(lvl)
 local list=sea==1 and Q1 or sea==2 and Q2 or sea==3 and Q3
 if not list then return nil end
 if sea==3 and lvl>=2600 then return nil end
 local q
 for _,v in ipairs(list) do if lvl>=v[1] then q=v else break end end
 return q
end
local function questHUD()
 local pg=LP:FindFirstChild('PlayerGui');local main=pg and pg:FindFirstChild('Main')
 local q=main and main:FindFirstChild('Quest')
 local questTitle=q and q:FindFirstChild('Container') and q.Container:FindFirstChild('QuestTitle')
 local title=questTitle and questTitle:FindFirstChild('Title')
 return q,title and title.Text or ''
end
local function getLevel()
 local data=LP:FindFirstChild('Data');local level=data and data:FindFirstChild('Level')
 return level and level.Value or 1
end
local function doFarm()
 local level=getLevel();local q=getQuest(level)
 if not q then
  status('Thiếu lộ trình Sea '..sea..' / Lv.'..level..' (2600+ chưa hỗ trợ)');stopMotion();return
 end
 if S.autoMastery then equipped(S.weapon) end
 local quest,qt=questHUD()
 if quest and quest.Visible and qt~='' and not string.find(qt,q[5],1,true) then
  status('Bỏ nhiệm vụ cũ');if os.clock()-S.lastQuest>3 then safeInvoke('AbandonQuest');S.lastQuest=os.clock() end
  stopMotion();return
 end
 if not quest or not quest.Visible or qt=='' then
  S.target=nil;status('Nhận nhiệm vụ '..q[2])
  local xyz=q[6];local npc=CFrame.new(xyz[1],xyz[2]+2,xyz[3])
  if go(npc,8) and os.clock()-S.lastQuest>2 then
   safeInvoke('StartQuest',q[3],q[4]);S.lastQuest=os.clock()
  end
  return
 end
 local xyz=q[7]
 local found=nearestMob(q[2],Vector3.new(xyz[1],xyz[2],xyz[3]),700)
 if not found then
  S.target=nil;status('Đợi quái: '..q[2]);go(CFrame.new(xyz[1],xyz[2]+S.height,xyz[3]),12)
  return
 end
 bringMobs(found);fight(found)
end
local function raidActive()
