local function bringMobs(m)
 if not S.bring or not alive(m) then return end
 local count=0;local root=m.HumanoidRootPart
 local enemies=workspace:FindFirstChild('Enemies');if not enemies then return end
 for _,other in ipairs(enemies:GetChildren()) do
  if other~=m and other.Name==m.Name and alive(other) and (other.HumanoidRootPart.Position-root.Position).Magnitude<80 then
   if type(isnetworkowner)=='function' then
    local ok,yes=pcall(isnetworkowner,other.HumanoidRootPart)
    if ok and yes then other.HumanoidRootPart.CFrame=root.CFrame;count=count+1 end
   end
   if count>=2 then break end
  end
 end
end
