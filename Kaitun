local ActiveTween, ActiveTarget, LastEntranceTime
local function CancelMove()
    if ActiveTween then pcall(function() ActiveTween:Cancel() end) end
    ActiveTween, ActiveTarget = nil, nil
end
LocalPlayer.CharacterAdded:Connect(function() CancelMove() end)
local function Tween(target, speed)
    local hrp = GetHRP()
    if not hrp or not target then return nil end
    speed = tonumber(speed) or 325
    local distance = (hrp.Position - target.Position).Magnitude
    if distance < 3 then CancelMove(); return nil end
    -- Reuse the same tween when its destination has not changed.
    if ActiveTween and ActiveTween.PlaybackState == Enum.PlaybackState.Playing and
        ActiveTarget and (ActiveTarget.Position - target.Position).Magnitude < 15 then
        return ActiveTween
    end
    CancelMove()
    local fixvelo = hrp:FindFirstChild("fixvelo")
    if not fixvelo then
        fixvelo = Instance.new("BodyVelocity")
        fixvelo.Name = "fixvelo"
        fixvelo.MaxForce = Vector3.new(0, 100000, 0)
        fixvelo.Velocity = Vector3.zero
        fixvelo.Parent = hrp
    end
    local nearest, nearestDist = nil, math.huge
    for _, entrance in ipairs(Entrance) do
        local d = (entrance - target.Position).Magnitude
        if d < nearestDist then nearest, nearestDist = entrance, d end
    end
    if nearest and nearestDist + 50 < distance and (not LastEntranceTime or os.clock() - LastEntranceTime > 5) then
        LastEntranceTime = os.clock()
        SafeInvoke("requestEntrance", nearest)
        distance = (hrp.Position - target.Position).Magnitude
    end
    ActiveTarget = target
    ActiveTween = TweenService:Create(hrp, TweenInfo.new(distance / speed, Enum.EasingStyle.Linear), {CFrame = target})
    ActiveTween:Play()
    return ActiveTween
end
local function MoveTo(target, speed)
    local hrp = GetHRP()
    if not hrp or not target then return false end
    if (hrp.Position - target.Position).Magnitude > 150 then
        Tween(target, speed or 325)
        return false
    end
    CancelMove()
    hrp.CFrame = target
    return true
end
local function MoveAndWait(target, timeout)
    local started = os.clock()
    local hrp = GetHRP()
    local distance = hrp and (hrp.Position - target.Position).Magnitude or 0
    local allowed = math.max(timeout or 30, distance / 325 + 15)
    repeat
        if MoveTo(target) then return true end
        task.wait(0.15)
    until os.clock() - started > allowed
    return false
end

-- Player / inventory
local function IsOwn(name)
    if not name then return nil end
    local char = LocalPlayer.Character
    return (char and char:FindFirstChild(name)) or LocalPlayer.Backpack:FindFirstChild(name)
end
local function EquipName(name)
    local tool = IsOwn(name)
    local char = LocalPlayer.Character
    if tool and tool:IsA("Tool") and char and char:FindFirstChild("Humanoid") then
        pcall(function() char.Humanoid:EquipTool(tool) end)
        return tool
    end
end
local function EquipWeapon(kind)
    local char = GetCharacter()
    for _, parent in ipairs({char, LocalPlayer.Backpack}) do
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("Tool") and obj.ToolTip == kind then
                EquipName(obj.Name)
                return obj
            end
        end
    end
    return nil
end
local function DieWait()
    local char = GetCharacter()
    local humanoid = char:WaitForChild("Humanoid")
    if humanoid.Health <= 0 then
        CancelMove()
        repeat task.wait(0.5) until GetCharacter():FindFirstChild("Humanoid") and GetCharacter().Humanoid.Health > 0
    end
end

