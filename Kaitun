 for i=1,5 do
  local part=loc:FindFirstChild('Island '..i)
  if part then return true,part end
 end
 return false,nil
end
local function raidLoop()
 local active,island=raidActive()
 if not active then
  S.target=nil;status('Raid: đợi bắt đầu / mua chip '..S.chip)
  if os.clock()-S.lastBuy>18 then S.lastBuy=os.clock();safeInvoke('RaidsNpc','Select',S.chip) end
  return
 end
 local mob=nearestMob(nil,hrp() and hrp().Position or Vector3.zero,500)
 if mob then fight(mob)
 elseif island and island:IsA('BasePart') then status('Raid: di chuyển lên đảo');go(island.CFrame*CFrame.new(0,25,0),12) end
end
local function seaEventLoop()
 local best,dist=nil,math.huge;local root=hrp();if not root then return end
 for _,folder in ipairs({workspace:FindFirstChild('SeaBeasts'),workspace:FindFirstChild('Enemies'),workspace}) do
  if folder then for _,v in ipairs(folder:GetChildren()) do
   local n=v.Name:lower()
   if (n:find('sea beast',1,true) or n:find('terror shark',1,true) or n:find('shark',1,true) and n:find('terror',1,true)) and alive(v) then
    local d=(v.HumanoidRootPart.Position-root.Position).Magnitude
    if d<dist then best,dist=v,d end
   end
  end end
 end
 if best then fight(best) else S.target=nil;status('Sea Event: đợi Sea Beast / Terror Shark xuất hiện') end
end
