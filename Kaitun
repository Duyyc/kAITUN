            for _, parent in ipairs({char,LocalPlayer.Backpack}) do
                for _, tool in ipairs(parent:GetChildren()) do
                    if tool:IsA("Tool") and tool.Name:lower():find("fruit",1,true) and tool:FindFirstChild("Handle") then
                        local original = tool:GetAttribute("OriginalName")
                        if original and not owned[original] then
                            EquipName(tool.Name)
