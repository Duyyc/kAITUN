    {Name="Dragon Talon",NPC="Uzoth",Beli=3000000,Fragments=5000,BuyID="BuyDragonTalon",Mastery=400,World=3},
    {Name="Godhuman",NPC="Ancient Monk",Beli=5000000,Fragments=5000,BuyID="BuyGodhuman",Mastery=400,World=3}
}
local MeleeByName = {}
local MeleeCompleted = {}
for _, m in ipairs(Melees) do MeleeByName[m.Name] = m end
local function CurrentMelee()
    local char = GetCharacter()
    for _, parent in ipairs({char,LocalPlayer.Backpack}) do
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("Tool") and obj.ToolTip == "Melee" then return obj end
        end
    end
    return nil
end
local function MeleeProgress()
    local current = CurrentMelee()
    if not current then
        subtitle.Text = "No melee tool detected; checking backpack"
        return
    end
    local mastery = current:FindFirstChild("Level") and current.Level.Value or 0
    local data = MeleeByName[current.Name]
    -- Current advanced style implies earlier styles in this progression were passed.
    if data then
        for _, m in ipairs(Melees) do
            if m.Name == current.Name then break end
            MeleeCompleted[m.Name] = true
        end
        if mastery >= data.Mastery then MeleeCompleted[current.Name] = true end
    end
    if data and mastery < data.Mastery then
        subtitle.Text = string.format("Farming Until %s Reaches %d Mastery (%d)",current.Name,data.Mastery,mastery)
        return
    end
    if current.Name ~= "Combat" and not data then
        subtitle.Text = "Farming With " .. current.Name
        return
    end
    local world = World1 and 1 or World2 and 2 or 3
    for _, m in ipairs(Melees) do
        if m.World > world then break end
        if not MeleeCompleted[m.Name] then
            local tool = IsOwn(m.Name)
            local existingMastery = tool and tool:FindFirstChild("Level") and tool.Level.Value or 0
            if existingMastery >= m.Mastery then
                MeleeCompleted[m.Name] = true
                continue
            end
            if tool then
                EquipName(m.Name)
                subtitle.Text = "Farming Until " .. m.Name .. " Reaches " .. m.Mastery .. " Mastery"
                return
            end
            local fragments = LocalPlayer.Data:FindFirstChild("Fragments")
            local availableFragments = fragments and fragments.Value or 0
            if LocalPlayer.Data.Beli.Value < m.Beli or availableFragments < m.Fragments then
                subtitle.Text = "Farming Resources For " .. m.Name
                return
            end
            local npcs = workspace:FindFirstChild("NPCs")
            local npc = (npcs and npcs:FindFirstChild(m.NPC)) or
                (ReplicatedStorage:FindFirstChild("NPCs") and ReplicatedStorage.NPCs:FindFirstChild(m.NPC))
            if npc and npc:FindFirstChild("HumanoidRootPart") then
                title.Text = "Get " .. m.Name
                if not MoveAndWait(npc.HumanoidRootPart.CFrame,25) then return end
            end
            SafeInvoke(m.BuyID)
            if IsOwn(m.Name) then EquipName(m.Name) end
            subtitle.Text = "Checking " .. m.Name
            return
        end
    end
    subtitle.Text = "Available Melee Progression Completed"
end

