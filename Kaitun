-- Only main worker commands character movement, preventing competing Tweens.
task.spawn(function()
 local retreat=false;local retreatAt
 local fruitFail,fruitRef=nil,nil
 while S.on do
  local ok,err=pcall(function()
   local h=hum();local root=hrp()
   if h and root and h.Health>0 then
    if S.safe and h.Health/h.MaxHealth<.50 then
     if not retreat then retreatAt=CFrame.new(root.Position+Vector3.new(0,65,0)) end
     retreat=true
    end
    if retreat and h.Health/h.MaxHealth>=.95 then retreat=false;retreatAt=nil end
    if retreat then S.target=nil;status('Đợi hồi máu ('..math.floor(h.Health/h.MaxHealth*100)..'%)');go(retreatAt,5)
    elseif S.fruitPickup and autoFruitLoop() then
      if fruitRef~=findFruit() then fruitRef=findFruit();fruitFail=os.clock() end
      if fruitRef and fruitFail and os.clock()-fruitFail>10 then
        status('Không nhặt được trái; tắt Auto Fruit để farm tiếp')
        S.fruitPickup=false;stopMotion()
      end
    elseif S.raid then raidLoop()
    elseif S.seaEvents then seaEventLoop()
    elseif S.autoFarm or S.autoMastery then doFarm()
    else S.target=nil; if flight then cleanupMove()end end
   else S.target=nil;cleanupMove();status('Đang đợi nhân vật hồi sinh') end
  end)
  if not ok then status('LỖI: '..tostring(err):sub(1,90));warn('[NEBULA]',err);S.target=nil;cleanupMove();task.wait(1) end
  task.wait(.18)
 end
end)
-- Combat worker: regular click input. Fast Attack does not bypass server rate limits.
task.spawn(function()
 while S.on do
  local h=hum();local target=S.target
  if h and h.Health>0 and not (S.safe and h.Health/h.MaxHealth<.50) and (S.fastAttack or target and alive(target)) then
   if S.fastAttack or (target and alive(target) and hrp() and (hrp().Position-target.HumanoidRootPart.Position).Magnitude<40) then
    if not Input:GetFocusedTextBox() then
     if not click() and S.fastAttack then status('Executor chưa hỗ trợ M1 tự động') end
    end
   end
  end
  task.wait(S.fastAttack and .14 or .32)
 end
end)
