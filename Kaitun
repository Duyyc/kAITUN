                        FruitBusy = true
                        title.Text = "Get " .. obj.Name
                        MoveAndWait(obj.Handle.CFrame,35)
                        task.wait(0.3)
                        FruitBusy = false
                        break
                    end
                end
            end
        end)
        FruitBusy = false
        if not ok then warn("[FRUITS]",err) end
    end
end)

