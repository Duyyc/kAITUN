local function toggle(page,name,key,callback)
 local btn=ui('TextButton',{Size=UDim2.new(1,-8,0,42),BackgroundColor3=C.pane,TextColor3=C.text,Font=Enum.Font.GothamSemibold,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,BorderSizePixel=0},page);round(btn,8)
