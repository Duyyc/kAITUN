 local function update() btn.Text=name..(S[key] and '                 [ ON ]' or '                 [ OFF ]');btn.TextColor3=S[key] and C.green or C.text end
 update()
 btn.MouseButton1Click:Connect(function()
  S[key]=not S[key];if callback then callback(S[key]) end;update()
 end)
 return btn
end
local function button(page,name,callback)
 local btn=ui('TextButton',{Text=name,Size=UDim2.new(1,-8,0,40),BackgroundColor3=C.hover,TextColor3=C.text,Font=Enum.Font.GothamSemibold,TextSize=13,BorderSizePixel=0},page)
